# Copy to repository-root .env.deploy.cloudflare (ignored by Git).
# GitHub/provider tokens are never sent to the running Worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=edge-mailer-smtp

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=
SMTP_FROM=sender@example.com
SMTP_TO=recipient@example.com
# Generate once with: openssl rand -hex 32
SAMPLE_SEND_TOKEN=

# For OAuth, replace password authentication with:
# SMTP_AUTH_TYPE=xoauth2
# SMTP_XOAUTH2_ACCESS_TOKEN=
