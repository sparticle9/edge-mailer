# Copy to repository-root .env.deploy.deno (ignored by Git).
# The provider token is never sent to the running app.
DENO_DEPLOY_TOKEN=
DENO_DEPLOY_ORG=
DENO_DEPLOY_APP=edge-mailer-smtp

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=
SMTP_FROM=sender@example.com
SMTP_TO=recipient@example.com
# Generate once with: openssl rand -hex 32
SAMPLE_SEND_TOKEN=

# DENO_ACCESS_TOKEN is also accepted for existing local setups.
# For OAuth, replace password authentication with:
# SMTP_AUTH_TYPE=xoauth2
# SMTP_XOAUTH2_ACCESS_TOKEN=
