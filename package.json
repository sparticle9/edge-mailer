{
  "name": "edge-mailer",
  "version": "0.0.0",
  "private": true,
  "description": "SMTP submission toolkit for edge and serverless runtimes.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.mjs",
      "require": "./dist/cloudflare.js"
    },
    "./deno": {
      "types": "./dist/deno.d.ts",
      "import": "./dist/deno.mjs",
      "require": "./dist/deno.js"
    }
  },
  "files": [
    "dist",
    "CLIENT-INTEGRATION.md",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "cloudflare",
    "workers",
    "cloudflare-workers",
    "deno",
    "email",
    "smtp",
    "serverless"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:smtp-core": "vitest --config vitest.smtp.config.mts --run",
    "test:deno": "deno test --config sample/deno-smtp/deno.json test/deno",
    "check:deno": "deno check --config sample/deno-smtp/deno.json src/deno.ts sample/deno-smtp/main.ts sample/deno-smtp/smoke.ts test/deno/deno-connector.test.ts",
    "test:smoke:deno": "direnv exec . sh -c 'cd sample/deno-smtp && deno task smoke'",
    "test:smoke:smtp": "direnv exec . node scripts/smtp-smoke.mjs",
    "format": "prettier '**/*.{json,ts,js,cjs,mjs,md}' --write --ignore-path .gitignore"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.7",
    "@cloudflare/workers-types": "^4.20260521.1",
    "@types/libqp": "^1.1.3",
    "@types/node": "^24.12.4",
    "@types/smtp-server": "^3.5.13",
    "letterparser": "^0.1.8",
    "libqp": "^2.1.1",
    "prettier": "^3.8.3",
    "smtp-server": "^3.18.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.7",
    "wrangler": "^4.93.0"
  }
}
