{
  "name": "edge-mailer",
  "version": "0.8.5",
  "description": "SMTP submission toolkit for edge and serverless runtimes.",
  "license": "MIT",
  "author": "sparticle9 <201596840+sparticle9@users.noreply.github.com>",
  "packageManager": "pnpm@11.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparticle9/edge-mailer.git"
  },
  "homepage": "https://github.com/sparticle9/edge-mailer#readme",
  "bugs": {
    "url": "https://github.com/sparticle9/edge-mailer/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.mjs",
      "require": "./dist/cloudflare.js"
    },
    "./deno": {
      "types": "./dist/deno.d.ts",
      "import": "./dist/deno.mjs",
      "require": "./dist/deno.js"
    }
  },
  "files": [
    "dist",
    "CLIENT-INTEGRATION.md",
    "CHANGELOG.md",
    "llms.txt",
    ".agents/skills/edge-mailer/SKILL.md",
    "LICENSE",
    "README.md",
    "USE-CASES.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "cloudflare",
    "workers",
    "cloudflare-workers",
    "deno",
    "email",
    "smtp",
    "serverless"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "changeset": "changeset",
    "version": "changeset version && pnpm run release:sync-jsr-version",
    "test:smtp-core": "vitest --config vitest.smtp.config.mts --run",
    "test:deno": "deno test --no-lock --allow-net=127.0.0.1,localhost --config sample/deno-smtp/deno.json test/deno",
    "check:deno": "deno check --no-lock --config sample/deno-smtp/deno.json src/deno.ts sample/deno-smtp/main.ts sample/deno-smtp/smoke.ts test/deno/deno-connector.test.ts test/deno/smtp-compat.test.ts",
    "release:check": "node scripts/release-check.mjs",
    "release:dry-run": "pnpm run release:check && pnpm run test:deploy && pnpm test -- --run && pnpm run test:smtp-core && pnpm run build && pnpm run check:starters && pnpm run check:deno && pnpm run test:deno && node scripts/check-package.mjs && deno publish --dry-run --config jsr.json",
    "release:sync-jsr-version": "node scripts/sync-jsr-version.mjs",
    "test:smoke:cloudflare": "direnv exec . node sample/cloudflare-worker-smtp/smoke.mjs",
    "test:smoke:deno": "direnv exec . sh -c 'cd sample/deno-smtp && deno task smoke'",
    "test:smoke:smtp": "direnv exec . node scripts/smtp-smoke.mjs",
    "format": "prettier '**/*.{json,ts,js,cjs,mjs,md}' --write --ignore-path .gitignore",
    "test:starters": "vitest run test/unit/starters.test.ts",
    "check:starters": "tsc -p sample/contact-form/tsconfig.json && tsc -p sample/durable-outbox/tsconfig.json && wrangler deploy --dry-run --config sample/contact-form/wrangler.jsonc --outdir /tmp/edge-mailer-contact-build && wrangler deploy --dry-run --config sample/durable-outbox/wrangler.jsonc --outdir /tmp/edge-mailer-outbox-build",
    "deploy:setup": "node scripts/deploy/setup.mjs",
    "test:deploy": "node --test test/unit/deploy.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/libqp": "^1.1.3",
    "@types/node": "^24.13.3",
    "@types/smtp-server": "^3.5.13",
    "letterparser": "^0.1.8",
    "libqp": "^2.1.1",
    "prettier": "^3.9.6",
    "smtp-server": "^3.19.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.7",
    "wrangler": "^4.129.0"
  }
}
