{
  "name": "edge-mailer",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Workers SMTP submission toolkit for serverless applications.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "cloudflare",
    "workers",
    "cloudflare-workers",
    "email",
    "smtp",
    "serverless"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:smoke:smtp": "node scripts/smtp-smoke.mjs",
    "format": "prettier '**/*.{json,ts,js,cjs,mjs,md}' --write --ignore-path .gitignore"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.7",
    "@cloudflare/workers-types": "^4.20260521.1",
    "@types/libqp": "^1.1.3",
    "@types/node": "^24.12.4",
    "letterparser": "^0.1.8",
    "libqp": "^2.1.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.7",
    "wrangler": "^4.93.0"
  }
}
