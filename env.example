# Edge Mailer env.example
#
# Copy this file to a local env file such as `.env`, `.env.local`, or a
# scenario-specific file before filling in real values.
# Never commit real passwords, OAuth tokens, private keys, or recipient PII.

# -----------------------------------------------------------------------------
# Core SMTP smoke / sample defaults
# -----------------------------------------------------------------------------
# These match the generic examples used across the repo.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=secret
SMTP_FROM=sender@example.com
SMTP_TO=recipient@example.net
SMTP_REPLY_TO=reply@example.net
SMTP_AUTH_TYPE=plain,login

# Optional transport tuning
SMTP_POOL_MAX_CONNECTIONS=1
SMTP_POOL_MAX_MESSAGES_PER_CONNECTION=20
SMTP_POOL_IDLE_TIMEOUT_MS=1000
SMTP_RESPONSE_TIMEOUT_MS=30000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_TLS_POLICY=require-starttls

# Required for the HTTP samples; generate your own token before deployment.
SAMPLE_SEND_TOKEN=

# -----------------------------------------------------------------------------
# XOAUTH2 SMTP smoke
# -----------------------------------------------------------------------------
# Swap the password for a short-lived OAuth access token when testing XOAUTH2.
#
# Google SMTP scope:
#   https://mail.google.com/
# Microsoft delegated SMTP scope:
#   https://outlook.office.com/SMTP.Send
# SMTP_AUTH_TYPE=xoauth2
# SMTP_XOAUTH2_ACCESS_TOKEN=access-token-goes-here

# -----------------------------------------------------------------------------
# Smoke-recipient aliases
# -----------------------------------------------------------------------------
# Some harnesses accept SMTP_TO, some accept TEST_RECIPIENT_EMAIL.
TEST_RECIPIENT_EMAIL=recipient@example.net

# -----------------------------------------------------------------------------
# DSN capture for live smoke evidence
# -----------------------------------------------------------------------------
# When enabled, smoke helpers request DSN and write JSON capture artifacts.
SMTP_SMOKE_DSN=1
SMTP_SMOKE_DSN_OUTPUT=smoke-artifacts/smtp-dsn.json

# -----------------------------------------------------------------------------
# Cloudflare Worker sample smoke
# -----------------------------------------------------------------------------
# Used by sample/cloudflare-worker-smtp and its smoke helper.
CLOUDFLARE_SAMPLE_PORT=8787

# -----------------------------------------------------------------------------
# Deno sample smoke
# -----------------------------------------------------------------------------
# Used by sample/deno-smtp and its smoke helper.
DENO_SAMPLE_URL=http://127.0.0.1:8789
